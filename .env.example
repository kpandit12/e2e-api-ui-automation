# Copy this file to .env and adjust as needed.
# All variables are prefixed QA_ so they never collide with OS-reserved names
# (e.g. Windows always sets USERNAME to the logged-in account).
# QA_PROFILE selects environment behaviour: local | ci | unit
QA_PROFILE=local
# Target app: OWASP Juice Shop, self-hosted via `docker compose up` (see
# docker-compose.yml) -> http://localhost:3000 for both API and UI.
QA_API_BASE_URL=http://localhost:3000
QA_UI_BASE_URL=http://localhost:3000
QA_TIMEOUT=30
QA_MAX_RETRIES=3
QA_BACKOFF_FACTOR=0.5
QA_BROWSER=chromium
QA_HEADLESS=true
