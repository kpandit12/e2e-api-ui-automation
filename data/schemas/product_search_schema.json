{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Juice Shop product search response",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "price"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "price": { "type": "number" },
          "image": { "type": ["string", "null"] }
        }
      }
    }
  }
}
